# Copy to .env (gitignored) and fill in. Secrets are read ONLY from env vars or .env,
# never from config/*.yaml. A process env var beats the same name in .env. Empty = unset.

# DeepSeek API key for the LLM gateway (Stage 24; the default provider).
DEEPSEEK_API_KEY=
# Anthropic API key, only when llm.provider is anthropic (optional provider).
ANTHROPIC_API_KEY=
# Alpaca paper-trading key id and secret (market data, news, paper broker).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# FRED API key for macro data (Stage 10).
FRED_API_KEY=
# SEC EDGAR requires a User-Agent with contact details, e.g. "Atlas Capital you@example.com".
SEC_USER_AGENT=

# Non-secret settings can also be overridden here or in the environment, e.g.:
# ATLAS__LIMITS__MAX_GROSS=1.5
